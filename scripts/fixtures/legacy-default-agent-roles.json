{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789"
      ]
    },
    "auth": {
      "mode": "token"
    }
  },
  "agents": {
    "entries": {
      "main": {},
      "borges": {},
      "jeeves": {},
      "babarsky": {},
      "randal": {},
      "glados": {}
    }
  },
  "bindings": [
    {
      "agentId": "borges",
      "match": {
        "channel": "telegram",
        "accountId": "borges"
      }
    },
    {
      "agentId": "jeeves",
      "match": {
        "channel": "telegram",
        "accountId": "jeeves"
      }
    },
    {
      "agentId": "babarsky",
      "match": {
        "channel": "telegram",
        "accountId": "babarsky"
      }
    },
    {
      "agentId": "randal",
      "match": {
        "channel": "telegram",
        "accountId": "randal"
      }
    },
    {
      "agentId": "glados",
      "match": {
        "channel": "telegram",
        "accountId": "glados"
      }
    }
  ],
  "env": {
    "vars": {
      "DEFAULT_ROLE_SMOKE_SECRET": "default-role-smoke-secret-3c15cf"
    }
  }
}
