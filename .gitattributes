# Shell scripts and workflow files must stay LF — they're COPY'd into a
# Linux image / parsed by CI. CRLF in the entrypoint = /bin/sh^M failures.
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
Dockerfile.media-hotfix text eol=lf
scripts/build-openclaw-media-fuse-adapter.mjs text eol=lf
scripts/fixtures/media-*.mjs text eol=lf
scripts/fixtures/image-publication-regression.mjs text eol=lf
*.yml text eol=lf
*.xml text eol=lf
